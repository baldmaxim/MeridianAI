# Пример env для portal-compose (§18). На VPS: meridian.env (НЕ в git), права 600.
# Реальные секреты — из secret storage, не из этого файла.

# Registry и immutable-тег образа (git SHA). Задаются deploy.sh.
REGISTRY=ghcr.io/<owner>
TAG=<git-sha>

# БД — только Yandex Managed PostgreSQL (порт 6432 = pgbouncer, SSL обязателен).
# Локального postgres-контейнера нет. asyncpg-драйвер + statement_cache отключается в коде.
DATABASE_URL=postgresql+asyncpg://<user>:<pass>@<host>.mdb.yandexcloud.net:6432/Meridian_AI
DATABASE_SSL=true
# Опц.: отдельный URL для миграций (DDL-юзер). Пусто = фолбэк на DATABASE_URL.
MIGRATION_DATABASE_URL=

# App-секреты
JWT_SECRET=<strong-random-secret>
ENCRYPTION_KEY=<fernet-key>

# CORS (prod-домен)
CORS_ORIGINS=https://app.example.com

# Observability (§20) — опционально
SENTRY_DSN=
ENVIRONMENT=production

# Keycloak OIDC (§9/§12). AUTH_MODE: local|keycloak|both (default local = SSO выключен).
# Активировать: AUTH_MODE=both + зарегистрировать confidential client `meridian` в realm your-realm,
# redirect URI = https://app.example.com/api/auth/oidc/callback, client role `admin` (опц.).
AUTH_MODE=local
OIDC_ISSUER=https://auth.example.com/realms/your-realm
OIDC_CLIENT_ID=meridian
OIDC_CLIENT_SECRET=<client-secret>
OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
FRONTEND_URL=https://app.example.com

# S3-совместимое хранилище (§15). Браузер грузит batch-аудио напрямую.
# На бакете включить CORS: PUT/GET с origin https://app.example.com.
S3_ENDPOINT=https://s3.example.com
S3_REGION=ru-central-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
# Presigned-ссылки через свой домен (ingress /s3) — нужно, если S3 недоступен клиенту
# напрямую. Пусто → ссылки идут прямо на S3_ENDPOINT. При включении поднять
# client_max_body_size на ВСЕХ прокси перед порталом, см. deploy/README-ingress-chain.md.
S3_PUBLIC_BASE_URL=https://app.example.com/s3
CORS_ORIGINS=["https://app.example.com"]

# --- Живые подсказки во встрече ---
# Signal Engine: LLM-классификатор переговорной ситуации. false (дефолт) = его решения
# реально управляют автоподсказками. true = классификатор пишет только трейсы, а подсказки
# триггерит legacy-поиск по ключевым словам («цена», «срок», …) — для переговоров бесполезно.
# Технический сбой классификатора в любом случае падает в legacy-ветку.
AI_SIGNAL_ENGINE_SHADOW_MODE=false

# Онлайн-встречи (Zoom/Teams/Meet): сторона реплики определяется по источнику звука —
# микрофон = мы, захват вкладки/экрана = оппонент. true = сторона проставляется спикеру
# автоматически (ручное назначение пользователем всегда главнее).
ONLINE_CAPTURE_SIDE_AUTO_APPLY=true
ONLINE_CAPTURE_SIDE_MIN_VOTES=3
ONLINE_CAPTURE_SIDE_MIN_RATIO=0.75

# --- Egress через прокси (гео-блокировки провайдеров) ---
# OpenRouter и ElevenLabs блокируют IP прод-сервера: прямой запрос к OpenRouter отдаёт
# 403 "Access denied by security policy". Оба клиента ходят через прокси в разрешённой
# стране. Пусто = напрямую (для сервера, чей IP не заблокирован).
OPENROUTER_PROXY_URL=http://<user>:<pass>@<proxy-host>:<port>
ELEVENLABS_PROXY_URL=http://<user>:<pass>@<proxy-host>:<port>

# --- OCR сканов: агент на компьютере с LM Studio (chandra-ocr-2) ---
# Модель работает за NAT, сервер до неё не достучится — адрес LM Studio серверу НЕ нужен.
# Скан ставится в очередь, агент сам забирает его по HTTPS (meridian-web/ocr-agent).
# Подключение компьютера: Админка → «Распознавание сканов» → «Подключить компьютер».
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_MAX_PAGES=150
# аренда задачи; каждая сданная страница её продлевает
OCR_AGENT_LEASE_SECONDS=600
OCR_AGENT_MAX_ATTEMPTS=3
OCR_AGENT_PDF_URL_TTL_SECONDS=900
OCR_AGENT_ONLINE_SECONDS=180
